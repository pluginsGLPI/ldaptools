{% if not can_use %}
    <div class="alert alert-warning d-flex align-items-center mx-auto mt-3" style="max-width: 42rem;" role="alert">
        <i class="ti ti-alert-triangle fs-2 me-3 flex-shrink-0"></i>
        <div>
            {{ __("The LDAP extension of your PHP parser isn't installed") }}
        </div>
    </div>
{% else %}
    <div class="container-fluid mt-3">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="ti ti-plug-connected me-2"></i>
                            {{ __('LDAP Tools', 'ldaptools') }}
                        </h3>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover table-vcenter card-table mb-0">
                                <thead>
                                    <tr>
                                        <th>{{ __('Tool', 'ldaptools') }}</th>
                                        <th>{{ __('Comment') }}</th>
                                        <th class="w-1"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for tool in tools %}
                                        <tr>
                                            <td>
                                                <i class="{{ tool.icon }} me-2 text-muted"></i>
                                                <strong>{{ tool.name }}</strong>
                                            </td>
                                            <td class="text-muted">{{ tool.comment }}</td>
                                            <td>
                                                <a href="{{ tool.link }}" class="btn btn-sm btn-outline-secondary">
                                                    <i class="ti ti-arrow-right me-1"></i>
                                                    {{ __('Open') }}
                                                </a>
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="3" class="text-center text-muted py-3">
                                                {{ __('No tools available') }}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endif %}
