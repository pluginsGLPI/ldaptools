<div class="container-fluid mt-3">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">
                <i class="ti ti-bug me-2"></i>
                {{ __('LDAP Test', 'ldaptools') }}
            </h3>
            <div class="card-options">
                <span class="badge bg-blue-lt">
                    <i class="ti ti-server me-1"></i>
                    {{ ldap_servers|length }} {{ __('server(s)', 'ldaptools') }}
                </span>
            </div>
        </div>
        <div class="card-body p-0">
            {% if ldap_servers is empty %}
                <div class="empty py-5">
                    <div class="empty-icon">
                        <i class="ti ti-server-off fs-1 text-muted"></i>
                    </div>
                    <p class="empty-title">{{ __('No LDAP directory configured', 'ldaptools') }}</p>
                    <p class="empty-subtitle text-muted">
                        {{ __('Go to Setup > Authentication > LDAP directories to add one.', 'ldaptools') }}
                    </p>
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-hover table-vcenter card-table mb-0" id="ldap_test_table">
                        <thead>
                            <tr>
                                <th>{{ __('LDAP', 'ldaptools') }}</th>
                                <th>
                                    {{ __('TCP stream', 'ldaptools') }}
                                </th>
                                <th>{{ __('BaseDN', 'ldaptools') }}</th>
                                <th>{{ __('LDAP URI', 'ldaptools') }}</th>
                                <th>{{ __('Bind auth', 'ldaptools') }}</th>
                                <th>
                                    {{ __('Generic search', 'ldaptools') }}
                                    {{ call('Html::showToolTip', [__('Forced limit: 50 entries max.', 'ldaptools')]) }}
                                </th>
                                <th>
                                    {{ __('Filtered search', 'ldaptools') }}
                                    {{ call('Html::showToolTip', [__('Forced limit: 50 entries max.', 'ldaptools')]) }}
                                </th>
                                <th>{{ __('Attributes', 'ldaptools') }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for ldap_items in ldap_servers %}
                                <tr id="ldap_test_{{ ldap_items.master.id }}_0">
                                    <td colspan="8" class="text-center text-muted py-2">
                                        <i class="ti ti-loader-2 ti-spin me-1"></i>
                                        {{ __('Running tests…', 'ldaptools') }}
                                    </td>
                                </tr>
                                {% for ldap_replicat in ldap_items.replicat %}
                                    <tr id="ldap_test_{{ ldap_items.master.id }}_{{ ldap_replicat.id }}">
                                        <td colspan="8" class="text-center text-muted py-2">
                                            <i class="ti ti-loader-2 ti-spin me-1"></i>
                                            {{ __('Running tests…', 'ldaptools') }}
                                        </td>
                                    </tr>
                                {% endfor %}
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
</div>

<script>
$(document).ready(function () {
    const ldapServers = {{ ldap_servers|json_encode|raw }};
    const ajaxUrl = "{{ call('Plugin::getWebDir', ['ldaptools']) }}/ajax/test.php";

    Object.values(ldapServers).forEach(function (ldapItems) {
        runTest(ajaxUrl, ldapItems.master, { id: 0 });
        ldapItems.replicat.forEach(function (ldapReplicat) {
            runTest(ajaxUrl, ldapItems.master, ldapReplicat);
        });
    });
});

function runTest(ajaxUrl, ldapMaster, ldapReplicat) {
    ldapReplicat = ldapReplicat || { id: 0 };
    $.ajax({
        type: 'GET',
        url: ajaxUrl,
        data: {
            authldaps_id: ldapMaster.id,
            authldapreplicates_id: ldapReplicat.id
        },
        success: function (data) {
            $('#ldap_test_' + ldapMaster.id + '_' + ldapReplicat.id).replaceWith(data);
        },
        error: function () {
            $('#ldap_test_' + ldapMaster.id + '_' + ldapReplicat.id).html(
                '<td colspan="8" class="text-danger"><i class="ti ti-alert-circle me-1"></i>'
                + '{{ __("Request failed", "ldaptools") }}'
                + '</td>'
            );
        }
    });
}
</script>
